# ==============================================================================
# BackupConfig - .gitignore
# ==============================================================================

# Herramientas locales, SAST y espacio privado del desarrollador (Regla 5 de AGENT.md)
user_data/

# Archivos temporales, copias de seguridad de editores y papelera
*.tmp
*.temp
*~
*.bak
*.swp
*.swo
.netrwhist
.directory

# Archivos de entorno de escritorio y sistemas operativos
.DS_Store
Thumbs.db

# Entornos y ajustes locales de IDEs
.idea/
.vscode/settings.json

# Archivos comprimidos de backups y logs generados en pruebas locales
*.tar.gz
*.tar.zst
*.tar.bz2
*.gpg
*.manifest.log
logs/
*.log
cache/
.cache/

# Archivos con secretos, certificados o llaves privadas
*.key
*.token
id_rsa*
id_ed25519*
*.pem
*.p12
*.jks
 
# Entornos de sandbox y pruebas locales end-to-end
sandbox/
modules.d/sandbox-*.conf
